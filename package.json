{
  "name": "palacio-firebase",
  "private": true,
  "type": "module",
  "scripts": {
    "emulators": "npm --prefix functions run build && firebase emulators:start",
    "seed": "node scripts/seed.ts",
    "console": "npm --prefix console run dev",
    "deploy:dev": "firebase deploy --project dev --only functions,firestore:rules,firestore:indexes,hosting",
    "seed:dev": "node scripts/seed.ts --project dev",
    "grant-operator": "node scripts/operator-access.ts grant",
    "grant-operator:dev": "node scripts/operator-access.ts grant --project dev",
    "revoke-operator": "node scripts/operator-access.ts revoke",
    "revoke-operator:dev": "node scripts/operator-access.ts revoke --project dev",
    "test": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions \"node --test test/*.test.ts\""
  },
  "devDependencies": {
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.36.0"
  }
}
